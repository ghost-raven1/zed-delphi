#!/bin/bash
set -euo pipefail

WASI_SDK_VERSION="34"
WASI_SDK_DIR="./target/wasi-sdk"

installed_version=""
if [ -f "${WASI_SDK_DIR}/VERSION" ]; then
    installed_version=$(head -n 1 "${WASI_SDK_DIR}/VERSION" | tr -d '\r')
fi

if [ "${installed_version}" = "${WASI_SDK_VERSION}.0" ]; then
    echo "WASI SDK v${WASI_SDK_VERSION} already exists at ${WASI_SDK_DIR}"
    exit 0
fi

if [ -d "${WASI_SDK_DIR}" ]; then
    echo "WASI SDK at ${WASI_SDK_DIR} is version '${installed_version}', replacing with v${WASI_SDK_VERSION}..."
else
    echo "WASI SDK not found, downloading v${WASI_SDK_VERSION}..."
fi

# Determine OS and architecture
OS=$(uname -s | tr '[:upper:]' '[:lower:]')
ARCH=$(uname -m)

# Map architecture names to WASI SDK format
case $ARCH in
    x86_64)
        ARCH="x86_64"
        ;;
    arm64|aarch64)
        ARCH="arm64"
        ;;
    *)
        echo "Unsupported architecture: $ARCH"
        exit 1
        ;;
esac

# Map OS names to WASI SDK format
case $OS in
    darwin)
        OS="macos"
        ;;
    linux)
        OS="linux"
        ;;
    mingw*|msys*|cygwin*)
        OS="windows"
        ;;
    *)
        echo "Unsupported OS: $OS"
        exit 1
        ;;
esac

# Construct download URL
WASI_SDK_URL="https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-${WASI_SDK_VERSION}/wasi-sdk-${WASI_SDK_VERSION}.0-${ARCH}-${OS}.tar.gz"

echo "Downloading from: $WASI_SDK_URL"

# Create target directory if it doesn't exist
mkdir -p ./target

# Keep the installed SDK intact until a complete replacement has been validated.
staging=$(mktemp -d ./target/wasi-sdk-install.XXXXXX)
cleanup() {
    if [ -d "$staging/previous-sdk" ] && [ ! -e "$WASI_SDK_DIR" ]; then
        if ! mv "$staging/previous-sdk" "$WASI_SDK_DIR"; then
            echo "Could not restore the previous SDK; preserved at $staging/previous-sdk" >&2
            return 1
        fi
    fi
    rm -r "$staging"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

curl --fail --location --retry 3 --retry-all-errors --retry-delay 2 \
    --retry-max-time 900 --connect-timeout 30 --max-time 600 \
    --output "$staging/archive.tar.gz" "$WASI_SDK_URL"
tar -xzf "$staging/archive.tar.gz" -C "$staging"
candidate="$staging/wasi-sdk-${WASI_SDK_VERSION}.0-${ARCH}-${OS}"
downloaded_version=$(head -n 1 "$candidate/VERSION" | tr -d '\r')
if [ "$downloaded_version" != "${WASI_SDK_VERSION}.0" ]; then
    echo "Unexpected WASI SDK version '$downloaded_version'; installation not changed" >&2
    exit 1
fi
compiler=clang
[ "$OS" != windows ] || compiler=clang.exe
if [ ! -f "$candidate/bin/$compiler" ] || [ ! -d "$candidate/share/wasi-sysroot" ]; then
    echo "Incomplete WASI SDK archive; installation not changed" >&2
    exit 1
fi

if [ -e "$WASI_SDK_DIR" ]; then
    mv "$WASI_SDK_DIR" "$staging/previous-sdk"
fi
mv "$candidate" "$WASI_SDK_DIR"

echo "WASI SDK v${WASI_SDK_VERSION} installed successfully"
