 { TSourceParser }
 
+procedure TSourceParser.CheckLazarusFormResource(Sender: TObject;
+  const aFileName: String; aOptions: TStrings);
+var
+  Source: TFileStream;
+  Binary: TMemoryStream;
+begin
+  // Validate the form stream without instantiating components or linking resources.
+  Source := TFileStream.Create(aFileName, fmOpenRead or fmShareDenyWrite);
+  try
+    Binary := TMemoryStream.Create;
+    try
+      ObjectTextToBinary(Source, Binary);
+    finally
+      Binary.Free;
+    end;
+  finally
+    Source.Free;
+  end;
+end;
